```gitignore
# ============================================
# Dependencies
# ============================================

node_modules/
.pnpm-store/


# ============================================
# Environment variables / secrets
# ============================================
.env*
!.env.example
!.env.*.example

# ============================================
# Next.js
# ============================================

.next/
out/

# Next.js build/debug
next-env.d.ts


# ============================================
# Node.js
# ============================================

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.tsbuildinfo


# ============================================
# Turborepo
# ============================================

.turbo/


# ============================================
# Build output
# ============================================

dist/
build/
coverage/

# Generic generated output
*.generated.*
generated/


# ============================================
# Tauri / Rust
# ============================================

# Rust build directory
target/

# Tauri generated artifacts
src-tauri/target/

# Tauri generated bundles/installers
src-tauri/gen/

# Rust lock file:
# Keep Cargo.lock for applications, so DO NOT ignore it.
# Cargo.lock should be committed for Cadence's desktop app.


# ============================================
# Testing
# ============================================

.nyc_output/
playwright-report/
test-results/

# Vitest
.vitest/


# ============================================
# IDEs / Editors
# ============================================

.idea/
.vscode/

# Keep shared VS Code settings if you decide to commit them
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

*.swp
*.swo
*~


# ============================================
# Operating system
# ============================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# ============================================
# Temporary files
# ============================================

*.tmp
*.temp
*.bak
*.swp

tmp/
temp/


# ============================================
# Database / local development
# ============================================

# Local SQLite databases, if ever used for development
*.sqlite
*.sqlite3
*.db

# Local database dumps
*.dump
*.sql.gz


# ============================================
# Logs
# ============================================

logs/
*.log


# ============================================
# Misc generated files
# ============================================

.cache/
.parcel-cache/
.eslintcache

# OS/editor backups
*.orig
*.rej
```

