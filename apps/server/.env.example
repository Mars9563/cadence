# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated browser origins allowed by CORS / Socket.IO
CORS_ORIGIN=http://localhost:3000

# Cloudinary (avatars). The API secret must only ever live here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional but recommended: a SIGNED upload preset with delivery type "authenticated"
CLOUDINARY_AVATAR_UPLOAD_PRESET=profile-upload
